//     ledcWrite(CH2, 0);
//     ledcWrite(CH3, speed);
//     ledcWrite(CH4, 0);
// }

// void Backwards(int rearspeed, int frontspeed) {   // speed: 0–255
//     ledcWrite(CH1, 0);
//     ledcWrite(CH2, speed);
//     ledcWrite(CH3, 0);
//     ledcWrite(CH4, speed);
// }

// void roll(int leftspeed, int rightspeed) {

//     //Front Left
//     ledcWrite(CH1, leftspeed); 
//     ledcWrite(CH2, 0);        
    
//     //Rear Left
//     ledcWrite(CH3, 0);
//     ledcWrite(CH4, leftspeed);

//     //Front Right
//     ledcWrite(CH5, 0);
//     ledcWrite(CH6, rightspeed);

//     //Rear Right
//     ledcWrite(CH7, rightspeed);
//     ledcWrite(CH8, 0);
// }

// void pitch(int frontspeed, int rearspeed) {

//    //Front Left
//     ledcWrite(CH1, frontspeed); 
//     ledcWrite(CH2, 0);        
    
//     //Rear Left
//     ledcWrite(CH3, 0);
//     ledcWrite(CH4, rearspeed);

//     //Front Right
//     ledcWrite(CH5, 0);
//     ledcWrite(CH6, frontspeed);

//     //Rear Right
//     ledcWrite(CH7, rearspeed);
//     ledcWrite(CH8, 0);
// }
void driveMotors(int leftspeed, int rightspeed, int frontspeed, int rearspeed) {
    // Each wheel blends its side's left/right speed with its axle's front/rear speed
    int fl = (leftspeed  + frontspeed) / 2;
    int rl = (leftspeed  + rearspeed)  / 2;
    int fr = (rightspeed + frontspeed) / 2;
    int rr = (rightspeed + rearspeed)  / 2;

    // ---- CHANGED FOR ESC CONTROL: map 0-255 speed to a 1000-2000us ESC pulse ----
    esc_FL.writeMicroseconds(map(fl, 0, 255, ESC_MIN_US, ESC_MAX_US));
    esc_RL.writeMicroseconds(map(rl, 0, 255, ESC_MIN_US, ESC_MAX_US));
    esc_FR.writeMicroseconds(map(fr, 0, 255, ESC_MIN_US, ESC_MAX_US));
    esc_RR.writeMicroseconds(map(rr, 0, 255, ESC_MIN_US, ESC_MAX_US));
    // ---- END CHANGED ----
}

// Arduino setup function. Runs in CPU 1
void setup() {

    Serial.begin(115200);

    // ---- CHANGED FOR ESC CONTROL: replaced ledcSetup/ledcAttachPin block ----
    ESP32PWM::allocateTimer(0);
    ESP32PWM::allocateTimer(1);
    ESP32PWM::allocateTimer(2);
    ESP32PWM::allocateTimer(3);

    esc_FL.setPeriodHertz(50);
    esc_RL.setPeriodHertz(50);
    esc_FR.setPeriodHertz(50);
    esc_RR.setPeriodHertz(50);

    esc_FL.attach(IN1, ESC_MIN_US, ESC_MAX_US);
    esc_RL.attach(IN3, ESC_MIN_US, ESC_MAX_US);
    esc_FR.attach(IN5, ESC_MIN_US, ESC_MAX_US);
    esc_RR.attach(IN7, ESC_MIN_US, ESC_MAX_US);

    // Send the arm signal before ESC power is connected / before throttle is used
    esc_FL.writeMicroseconds(ESC_MIN_US);
    esc_RL.writeMicroseconds(ESC_MIN_US);
    esc_FR.writeMicroseconds(ESC_MIN_US);
    esc_RR.writeMicroseconds(ESC_MIN_US);
    Serial.println("Sending arm signal to all 4 ESCs. Connect ESC/battery power now.");
    delay(3000);
    Serial.println("Armed.");
    // ---- END CHANGED ----




    Serial.printf("Firmware: %s\n", BP32.firmwareVersion());
    const uint8_t* addr = BP32.localBdAddress();
    Serial.printf("BD Addr: %2X:%2X:%2X:%2X:%2X:%2X\n", addr[0], addr[1], addr[2], addr[3], addr[4], addr[5]);

    // Setup the Bluepad32 callbacks
    BP32.setup(&onConnectedController, &onDisconnectedController);

    // "forgetBluetoothKeys()" should be called when the user performs
    // a "device factory reset", or similar.
    // Calling "forgetBluetoothKeys" in setup() just as an example.
    // Forgetting Bluetooth keys prevents "paired" gamepads to reconnect.
    // But it might also fix some connection / re-connection issues.
    BP32.forgetBluetoothKeys();

    // Enables mouse / touchpad support for gamepads that support them.
    // When enabled, controllers like DualSense and DualShock4 generate two connected devices:
    // - First one: the gamepad
    // - Second one, which is a "virtual device", is a mouse.
    // By default, it is disabled.
    BP32.enableVirtualDevice(false);
}

// Arduino loop function. Runs in CPU 1.
void loop() {

    BP32.update();
    
    for (auto myController : myControllers) {
     
        if (myController && myController->isConnected() && myController->hasData()) {
     
            if (myController->isGamepad()) {
                
                GamepadData Controldata = processGamepad(myController);

                motor_pwm     = map(Controldata.throttle,0,1023,0,255);
                int leftX     = abs(Controldata.leftX);
                int leftY     = abs(Controldata.leftY);
                leftrightbias = map(leftX,0,512,0,255);
                frontrearbias = map(leftY,0,512,0,255);
              
                
                // Serial.printf("Motorpwm");
                // Serial.printf("%d",motor_pwm);
                // Serial.print("\n");

                if (Controldata.leftX < 40) {    //Roll Left

                    leftspeed  = motor_pwm*(1.0-(leftrightbias/255.0));
                    rightspeed = motor_pwm;
                    
                }

                 if (Controldata.leftX > 40) {   //Roll Right

                    rightspeed  = motor_pwm*(1.0-(leftrightbias/255.0));
                    leftspeed = motor_pwm;
                   
                }

               if (Controldata.leftY < 40) {    //Pitch Forward

                    frontspeed  = motor_pwm*(1.0-(frontrearbias/255.0));
                    rearspeed   = motor_pwm;
                    
                }

                if (Controldata.leftY > 40) {    //Pitch Backwards

                    rearspeed  = motor_pwm*(1.0-(frontrearbias/255.0));
                    frontspeed   = motor_pwm;

                }



                Serial.printf("%d %d %d %d %d\n", leftspeed, rightspeed, frontspeed, rearspeed, motor_pwm);
                driveMotors(leftspeed, rightspeed, frontspeed, rearspeed);
                

            }
        }
    }
}
