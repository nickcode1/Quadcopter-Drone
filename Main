#include <Bluepad32.h>
#include "data.h"
#include <ESP32Servo.h>
#include "IMU.h"

IMU imu;

ControllerPtr myControllers[BP32_MAX_GAMEPADS];

// This callback gets called any time a new gamepad is connected.
// Up to 4 gamepads can be connected at the same time.
void onConnectedController(ControllerPtr ctl) {
    bool foundEmptySlot = false;
    for (int i = 0; i < BP32_MAX_GAMEPADS; i++) {
        if (myControllers[i] == nullptr) {
            Serial.printf("CALLBACK: Controller is connected, index=%d\n", i);
            // Additionally, you can get certain gamepad properties like:
            // Model, VID, PID, BTAddr, flags, etc.
            ControllerProperties properties = ctl->getProperties();
            Serial.printf("Controller model: %s, VID=0x%04x, PID=0x%04x\n", ctl->getModelName().c_str(), properties.vendor_id,
                           properties.product_id);
            myControllers[i] = ctl;
            foundEmptySlot = true;
            break;
        }
    }
    if (!foundEmptySlot) {
        Serial.println("CALLBACK: Controller connected, but could not found empty slot");
    }
}

void onDisconnectedController(ControllerPtr ctl) {
    bool foundController = false;

    for (int i = 0; i < BP32_MAX_GAMEPADS; i++) {
        if (myControllers[i] == ctl) {
            Serial.printf("CALLBACK: Controller disconnected from index=%d\n", i);
            myControllers[i] = nullptr;
            foundController = true;
            break;
        }
    }

    if (!foundController) {
        Serial.println("CALLBACK: Controller disconnected, but not found in myControllers");
    }
}

void dumpGamepad(ControllerPtr ctl) {
    Serial.printf(
        "idx=%d, dpad: 0x%02x, buttons: 0x%04x, axis L: %4d, %4d, axis R: %4d, %4d, brake: %4d, throttle: %4d, "
        "misc: 0x%02x, gyro x:%6d y:%6d z:%6d, accel x:%6d y:%6d z:%6d\n",
        ctl->index(),        // Controller Index
        ctl->dpad(),         // D-pad
        ctl->buttons(),      // bitmask of pressed buttons
        ctl->axisX(),        // (-511 - 512) left X Axis
        ctl->axisY(),        // (-511 - 512) left Y axis
        ctl->axisRX(),       // (-511 - 512) right X axis
        ctl->axisRY(),       // (-511 - 512) right Y axis
        ctl->brake(),        // (0 - 1023): brake button
        ctl->throttle(),     // (0 - 1023): throttle (AKA gas) button
        ctl->miscButtons(),  // bitmask of pressed "misc" buttons
        ctl->gyroX(),        // Gyro X
        ctl->gyroY(),        // Gyro Y
        ctl->gyroZ(),        // Gyro Z
        ctl->accelX(),       // Accelerometer X
        ctl->accelY(),       // Accelerometer Y
        ctl->accelZ()        // Accelerometer Z
    );
}

GamepadData processGamepad(ControllerPtr ctl) {
    
    GamepadData data;

    data.leftY = ctl->axisY();
    data.leftX = ctl->axisX();
    data.throttle = ctl->throttle();
    data.brake = ctl->brake();
    data.buttons = ctl->buttons();

    return data;
}

// PWM config
const int CH1 = 0;
const int CH2 = 1;
const int CH3 = 2;
const int CH4 = 3;
const int CH5 = 4;
const int CH6 = 5;
const int CH7 = 6;
const int CH8 = 7;

const int FREQ = 5000;   // 5 kHz
const int RES  = 8;      // 8-bit: 0–255

//Pin Outs
const int IN1 = 13;
const int IN2 = 12;

const int IN3 = 14;
const int IN4 = 27;

const int IN5 = 26;
const int IN6 = 25;

const int IN7 = 33;
const int IN8 = 32;

int leftspeed;
int rightspeed;
int frontspeed;
int rearspeed;
int motor_pwm;
int leftrightbias;
int frontrearbias;

Servo frontLeft;
Servo rearLeft;
Servo frontRight;
Servo rearRight;

// ---- PID stabilization additions ----
struct PID {
  float kp, ki, kd;
  float integral;
  float prevMeasurement;
  float integralLimit;

  float update(float setpoint, float measurement, float dt) {
    float error = setpoint - measurement;
    integral = constrain(integral + error * dt, -integralLimit, integralLimit);
    float derivative = -(measurement - prevMeasurement) / dt;  // derivative-on-measurement
    prevMeasurement = measurement;
    return kp * error + ki * integral + kd * derivative;
  }
};

PID rollPID  = {5.0, 0.0, 0.0, 0, 0, 50};   // kp-only to start; tune kp, then kd, then ki
PID pitchPID = {5.0, 0.0, 0.0, 0, 0, 50};

float rollAngle = 0, pitchAngle = 0;
unsigned long lastLoopTime = 0;

const float MAX_TILT_DEG = 25.0;      // full stick deflection = this many degrees commanded
const float ACC_FILTER_ALPHA = 0.98;  // complementary filter weight toward gyro
// ---- end PID additions ----


void driveMotors(int leftspeed, int rightspeed, int frontspeed, int rearspeed) {
    // Each wheel blends its side's left/right speed with its axle's front/rear speed
    int fl = (leftspeed  + frontspeed) / 2;
    int rl = (leftspeed  + rearspeed)  / 2;
    int fr = (rightspeed + frontspeed) / 2;
    int rr = (rightspeed + rearspeed)  / 2;

    // Send signal 1000-2000 to each ESC
    frontLeft.writeMicroseconds(fl);
    rearLeft.writeMicroseconds(rl);
    frontRight.writeMicroseconds(fr);  
    rearRight.writeMicroseconds(rr); 

}

// Arduino setup function. Runs in CPU 1
void setup() {

    Serial.begin(115200);

    if (!imu.begin()) {
        Serial.println("IMU init failed!");
        while (1) { delay(1000); }
    }

    frontLeft.attach(IN1);
    rearLeft.attach(IN2);
    frontRight.attach(IN3);
    rearRight.attach(IN4);

    frontLeft.setPeriodHertz(50);
    rearLeft.setPeriodHertz(50);
    frontRight.setPeriodHertz(50);
    rearRight.setPeriodHertz(50);

    // Send arming signal
    frontLeft.writeMicroseconds(1000);
    rearLeft.writeMicroseconds(1000);
    frontRight.writeMicroseconds(1000);  
    rearRight.writeMicroseconds(1000); 

    delay(3000); // wait to arm
    
    // Should implement arming verification here later

    Serial.printf("Firmware: %s\n", BP32.firmwareVersion());
    const uint8_t* addr = BP32.localBdAddress();
    Serial.printf("BD Addr: %2X:%2X:%2X:%2X:%2X:%2X\n", addr[0], addr[1], addr[2], addr[3], addr[4], addr[5]);

    // Setup the Bluepad32 callbacks
    BP32.setup(&onConnectedController, &onDisconnectedController);

    // "forgetBluetoothKeys()" should be called when the user performs
    // a "device factory reset", or similar.
    // Calling "forgetBluetoothKeys" in setup() just as an example.
    // Forgetting Bluetooth keys prevents "paired" gamepads to reconnect.
    // But it might also fix some connection / re-connection issues.
    BP32.forgetBluetoothKeys();

    // Enables mouse / touchpad support for gamepads that support them.
    // When enabled, controllers like DualSense and DualShock4 generate two connected devices:
    // - First one: the gamepad
    // - Second one, which is a "virtual device", is a mouse.
    // By default, it is disabled.
    BP32.enableVirtualDevice(false);
}

// Arduino loop function. Runs in CPU 1.
void loop() {

    BP32.update();
    imu.update();

    float aroll  = imu.getAccX();   // raw accel
    float apitch = imu.getAccY();
    float az     = imu.getAccZ();
    float gx     = imu.getGyroX();  // confirm this is deg/s in IMU.h
    float gy     = imu.getGyroY();
    float gz     = imu.getGyroZ();

    unsigned long now = micros();
    float dt = (lastLoopTime == 0) ? 0.004f : (now - lastLoopTime) / 1000000.0f;
    lastLoopTime = now;

    // accel-only angle estimate -- adjust signs once you confirm mounting orientation
    float accRollAngle  = atan2(apitch, az) * 180.0 / PI;
    float accPitchAngle = atan2(-aroll, sqrt(apitch * apitch + az * az)) * 180.0 / PI;

    // complementary filter: trust integrated gyro short-term, accel corrects long-term drift
    rollAngle  = ACC_FILTER_ALPHA * (rollAngle  + gx * dt) + (1 - ACC_FILTER_ALPHA) * accRollAngle;
    pitchAngle = ACC_FILTER_ALPHA * (pitchAngle + gy * dt) + (1 - ACC_FILTER_ALPHA) * accPitchAngle;

    for (auto myController : myControllers) {
     
        if (myController && myController->isConnected() && myController->hasData()) {
     
            if (myController->isGamepad()) {
                
                GamepadData Controldata = processGamepad(myController);

                motor_pwm = map(Controldata.throttle, 0, 1023, 1000, 2000);

                float desiredRoll  = (Controldata.leftX / 512.0f) * MAX_TILT_DEG;
                float desiredPitch = (Controldata.leftY / 512.0f) * MAX_TILT_DEG;

                float rollCorrection  = rollPID.update(desiredRoll,  rollAngle,  dt);
                float pitchCorrection = pitchPID.update(desiredPitch, pitchAngle, dt);

                // signs assume: stick-left -> roll left -> left motors slow down
                // (matches the original threshold logic). Flip signs here if it rolls
                // the wrong way during the props-off bench check.
                leftspeed  = constrain((int)(motor_pwm + rollCorrection),  1000, 2000);
                rightspeed = constrain((int)(motor_pwm - rollCorrection),  1000, 2000);
                frontspeed = constrain((int)(motor_pwm + pitchCorrection), 1000, 2000);
                rearspeed  = constrain((int)(motor_pwm - pitchCorrection), 1000, 2000);

            }

           
        }
    }

    Serial.print("Angle roll/pitch: ");
    Serial.print(rollAngle); Serial.print(", ");
    Serial.print(pitchAngle);
    Serial.print(" | Gyro: ");
    Serial.print(gx); Serial.print(", ");
    Serial.print(gy); Serial.print(", ");
    Serial.println(gz);
    
    driveMotors(leftspeed, rightspeed, frontspeed, rearspeed);
}
